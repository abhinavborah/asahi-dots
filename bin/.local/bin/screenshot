#!/bin/sh
# Screen (default, Enter) saves+copies full screen. Area picks a region, then Copy/Save/Both.
dir=$HOME/Pictures/Screenshots
mkdir -p "$dir"
f=$dir/$(date +%Y-%m-%d_%H-%M-%S).png

mode=$(printf 'Screen\nArea\n' | rofi -dmenu -i -p capture) || exit 0
case $mode in
Screen)
    sleep 0.3
    grim "$f" && wl-copy -t image/png < "$f" && notify-send screenshot "$f"
    ;;
Area)
    g=$(slurp) || exit 0
    act=$(printf 'Copy\nSave\nBoth\n' | rofi -dmenu -i -p action) || exit 0
    sleep 0.3
    case $act in
    Copy) grim -g "$g" - | wl-copy -t image/png ;;
    Save) grim -g "$g" "$f" && notify-send screenshot "$f" ;;
    Both) grim -g "$g" "$f" && wl-copy -t image/png < "$f" && notify-send screenshot "$f" ;;
    esac
    ;;
esac
